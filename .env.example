# Local environment example.
# Copy this file to .env and edit values for your machine.
#
# Never commit .env.

APP_ENV=local

CONTROL_PLANE_HTTP_ADDR=:8081
ERP_HTTP_ADDR=:8080

# Used by local migration scripts.
# This should be a DB owner/migration role, not the future app runtime role.
MIGRATION_DATABASE_URL=postgres://erp_owner:erp_owner_dev_password@localhost:5432/erp_go?sslmode=disable

# Used later by erp-api/control-plane-api runtime.
# This should be a least-privileged application role.
ERP_DATABASE_URL=postgres://erp_app:erp_app_dev_password@localhost:5432/erp_go?sslmode=disable

MIGRATIONS_DIR=./migrations
